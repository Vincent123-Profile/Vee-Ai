{
  "rules": {
    ".read": false,
    ".write": false,
    "visitors": {
      ".read": false,
      ".write": false
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "privateBusiness": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['vault'])",
        "vault": {
          ".validate": "newData.hasChildren(['version','salt','iv','ciphertext','updatedAtMs'])"
        }
      }
    },
    "privateBusinessAccount": {
      ".read": false,
      ".write": false
    },
    "privateBusinessAutomation": {
      ".read": false,
      ".write": false
    },
    "privateBusinessAutomationRate": {
      ".read": false,
      ".write": false
    },
    "gmailConnections": {
      ".read": false,
      ".write": false
    },
    "gmailOAuthStates": {
      ".read": false,
      ".write": false
    }
  }
}
{
  "rules": {
    ".read": false,
    ".write": false,
    "visitors": {
      ".read": "auth != null && auth.token.email === 'agboolavincent67@gmail.com' && auth.token.email_verified === true",
      "$visitorId": {
        ".read": "auth != null && auth.token.email === 'agboolavincent67@gmail.com' && auth.token.email_verified === true",
        ".write": "auth != null && auth.token.email === 'agboolavincent67@gmail.com' && auth.token.email_verified === true"
      }
    },
    "users": {
      ".read": "auth != null && auth.token.email === 'agboolavincent67@gmail.com' && auth.token.email_verified === true",
      ".write": "auth != null && auth.token.email === 'agboolavincent67@gmail.com' && auth.token.email_verified === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.token.email === 'agboolavincent67@gmail.com' && auth.token.email_verified === true))",
        ".write": "auth != null && (auth.uid === $uid || (auth.token.email === 'agboolavincent67@gmail.com' && auth.token.email_verified === true))"
      }
    },
    "privateBusiness": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['vault'])",
        "vault": {
          ".validate": "newData.hasChildren(['version','salt','iv','ciphertext','updatedAtMs'])"
        }
      }
    },
    "privateBusinessAutomation": {
      ".read": false,
      ".write": false
    },
    "privateBusinessAutomationRate": {
      ".read": false,
      ".write": false
    }
  }
}
